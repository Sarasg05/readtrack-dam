<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="80dp">

        <!-- PORTADA GRANDE -->
        <ImageView
            android:id="@+id/imgBookDetail"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:scaleType="centerCrop"/>

        <!-- INFO -->
        <LinearLayout
            android:padding="16dp"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:layout_margin="16dp">

            <TextView
                android:id="@+id/txtTitleDetail"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/txtAuthorDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/txtTotalPagesDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/txtGenresDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <!-- SINOPSIS -->
        <TextView
            android:id="@+id/txtSynopsis"
            android:padding="16dp"
            android:text="Sinopsis..."
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:lineSpacingExtra="4dp"/>

        <!-- BOTONES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp">

            <!-- READING -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btnReading"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_reading"
                    android:contentDescription="Reading"
                    app:tint="@android:color/white"
                    android:padding="14dp"
                    android:background="@drawable/bg_circle_button"
                    android:backgroundTint="#BB86FC"
                    android:scaleType="centerInside"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reading"
                    android:textSize="12sp"
                    android:textColor="@color/textSecondary"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>

            <!-- COMPLETED -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btnCompleted"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_completed"
                    android:contentDescription="Completed"
                    app:tint="@android:color/white"
                    android:padding="14dp"
                    android:background="@drawable/bg_circle_button"
                    android:backgroundTint="#4CAF50"
                    android:scaleType="centerInside"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Completed"
                    android:textSize="12sp"
                    android:textColor="@color/textSecondary"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>

            <!-- WISHLIST -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btnWishlist"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_wishlist"
                    android:contentDescription="Wishlist"
                    app:tint="@android:color/white"
                    android:padding="14dp"
                    android:background="@drawable/bg_circle_button"
                    android:backgroundTint="#FFB300"
                    android:scaleType="centerInside"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wishlist"
                    android:textSize="12sp"
                    android:textColor="@color/textSecondary"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- ESTRELLAS (reseña futura) -->
        <RatingBar
            android:id="@+id/ratingBar"
            android:numStars="5"
            android:stepSize="1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"/>

        <EditText
            android:id="@+id/etReview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Write a review..."
            android:minLines="4"
            android:gravity="top"
            android:layout_margin="16dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:textColor="@color/text"
            android:textColorHint="@color/textSecondary"/>

        <Button
            android:id="@+id/btnSendReview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Post review"
            android:layout_margin="16dp"
            android:background="@drawable/btn_primary"
            android:textAllCaps="false"/>

    </LinearLayout>
</ScrollView>